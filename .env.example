# Where the SQLite file lives, relative to the project root. This is also the
# default when DATABASE_URL isn't set. The data folder is gitignored, so quiz
# data stays out of the repo.
DATABASE_URL="file:./database/data/quiz.db"

# The Ollama model that writes quizzes, and where Ollama runs. These are the
# defaults when the variables aren't set.
OLLAMA_MODEL="qwen3:1.7b"
OLLAMA_BASE_URL="http://localhost:11434"

# The Ollama model that embeds chunks and topics. This is the default when the
# variable isn't set. Changing it means re-ingesting and recalibrating the
# similarity threshold.
OLLAMA_EMBEDDING_MODEL="all-minilm"

# Where Qdrant, the vector database, runs, and the folder of markdown sources
# ingestion reads. These are the defaults when the variables aren't set.
QDRANT_URL="http://localhost:6333"
KNOWLEDGE_BASE_DIR="knowledge-base"

# Set to true to show the "Skip retrieval" checkbox, so the group can generate
# the same topic with and without sources. Off by default.
DEMO_MODE="false"

# Docker Compose only: the port on your machine when 3000 is taken.
APP_PORT="3000"

# Docker Compose only: the port on your machine for Qdrant's API and dashboard.
QDRANT_PORT="6333"
