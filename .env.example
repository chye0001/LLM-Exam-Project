# Where the SQLite file lives, relative to the project root. This is also the
# default when DATABASE_URL isn't set. The data folder is gitignored, so quiz
# data stays out of the repo.
DATABASE_URL="file:./src/shared/db/data/quiz.db"

# The Ollama model that writes quizzes, and where Ollama runs. These are the
# defaults when the variables aren't set.
OLLAMA_MODEL="qwen3:1.7b"
OLLAMA_BASE_URL="http://localhost:11434"
