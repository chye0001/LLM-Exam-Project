generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
}

model Quiz {
  id         String     @id @default(cuid())
  topic      String
  ungrounded Boolean
  createdAt  DateTime   @default(now())
  questions  Question[]
  excerpts   Excerpt[]
  attempts   Attempt[]
}

model Question {
  id          String   @id @default(cuid())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId      String
  position    Int
  text        String
  explanation String
  options     Option[]
  answers     Answer[]

  @@unique([quizId, position])
}

model Option {
  id         String   @id @default(cuid())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  position   Int
  text       String
  isCorrect  Boolean
  answers    Answer[]

  @@unique([questionId, position])
}

model Excerpt {
  id          String @id @default(cuid())
  quiz        Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId      String
  position    Int
  chunkId     String
  sourceTitle String
  text        String
  similarity  Float

  @@unique([quizId, position])
}

model Attempt {
  id        String   @id @default(cuid())
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId    String
  createdAt DateTime @default(now())
  score     Int
  answers   Answer[]
}

model Answer {
  id         String   @id @default(cuid())
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId  String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  option     Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId   String

  @@unique([attemptId, questionId])
}
